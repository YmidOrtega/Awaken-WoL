<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material text appearances re-based on JetBrains Mono -->
    <style name="TextAppearance.App.Headline5" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
    </style>
    <style name="TextAppearance.App.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
    </style>
    <style name="TextAppearance.App.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
    </style>
    <style name="TextAppearance.App.Subtitle2" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
    </style>
    <style name="TextAppearance.App.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
    </style>
    <style name="TextAppearance.App.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
    </style>
    <style name="TextAppearance.App.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
    </style>
    <style name="TextAppearance.App.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.App.Overline" parent="TextAppearance.MaterialComponents.Overline">
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
    </style>

    <!-- Dot-matrix display text (titles, device names, figures) -->
    <style name="TextAppearance.App.Display" parent="">
        <item name="fontFamily">@font/doto_extrabold</item>
        <item name="android:fontFamily">@font/doto_extrabold</item>
        <item name="android:textColor">@color/primaryTextColor</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.App.Display.Title">
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="TextAppearance.App.Display.DeviceName">
        <item name="android:textSize">21sp</item>
    </style>
    <style name="TextAppearance.App.Display.Figure">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/ledOnlineColor</item>
    </style>

    <!-- Small monospaced metadata (IP, MAC, captions) -->
    <style name="TextAppearance.App.Meta" parent="">
        <item name="fontFamily">@font/jetbrains_mono</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/primaryTextColorMuted</item>
    </style>
    <style name="TextAppearance.App.Label" parent="TextAppearance.App.Meta">
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- "› action" text buttons used in device rows -->
    <style name="Widget.App.ConsoleAction" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/primaryTextColor</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Widget.App.ConsoleAction.Dim">
        <item name="android:textColor">@color/primaryTextColorMuted</item>
    </style>

    <!-- Full-width "› action" row with a divider, for screens that list a few commands -->
    <style name="Widget.App.ConsoleRowAction" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/console_row_action_background</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/primaryTextColor</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Outlined text fields: hairline box that turns green on focus -->
    <style name="Widget.App.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/console_input_stroke</item>
        <item name="boxBackgroundColor">@color/surfaceColor</item>
        <item name="boxCornerRadiusTopStart">6dp</item>
        <item name="boxCornerRadiusTopEnd">6dp</item>
        <item name="boxCornerRadiusBottomStart">6dp</item>
        <item name="boxCornerRadiusBottomEnd">6dp</item>
        <item name="hintTextColor">@color/ledOnlineColor</item>
        <item name="android:textColorHint">@color/primaryTextColorMuted</item>
        <item name="hintTextAppearance">@style/TextAppearance.App.Caption</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.App.Caption</item>
        <item name="helperTextTextColor">@color/primaryTextColorMuted</item>
        <item name="errorTextAppearance">@style/TextAppearance.App.Caption</item>
    </style>

    <!-- Default MaterialButton: outlined, console colours -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/consoleLineColor</item>
        <item name="android:textColor">@color/primaryTextColor</item>
        <item name="iconTint">@color/ledOnlineColor</item>
        <item name="cornerRadius">6dp</item>
        <item name="rippleColor">#1F43D9A3</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
    </style>

    <!-- Filled green button for the one primary action on a screen -->
    <style name="Widget.App.Button.Primary" parent="Widget.MaterialComponents.Button">
        <!-- The outlined default button style would otherwise leak its stroke in -->
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">@color/ledOnlineColor</item>
        <item name="android:textColor">@color/onAccentColor</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Dot-matrix screen title for activities that keep a toolbar -->
    <style name="TextAppearance.App.Display.ToolbarTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Section label inside forms, e.g. "GENERAL" -->
    <style name="TextAppearance.App.SectionLabel" parent="TextAppearance.App.Label">
        <item name="android:textColor">@color/ledOnlineColor</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Dialogs: console surface, dot-matrix title, green text buttons -->
    <style name="ThemeOverlay.App.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/surfaceColor</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.App.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.App.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.DialogButton.Dim</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.App.DialogButton.Dim</item>
    </style>
    <style name="ShapeAppearance.App.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="MaterialAlertDialog.App.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:fontFamily">@font/doto_extrabold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/primaryTextColor</item>
    </style>
    <style name="MaterialAlertDialog.App.Body" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">@color/primaryTextColorMuted</item>
    </style>
    <style name="Widget.App.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <!-- The outlined default button style would otherwise leak its stroke in -->
        <item name="strokeWidth">0dp</item>
        <item name="android:textColor">@color/ledOnlineColor</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="rippleColor">#1F43D9A3</item>
    </style>
    <style name="Widget.App.DialogButton.Dim">
        <item name="android:textColor">@color/primaryTextColorMuted</item>
    </style>

    <!-- Bottom text tabs -->
    <style name="Widget.App.ConsoleTab" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/console_tab_background</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:textColor">@color/console_tab_text</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Snackbars as console notices -->
    <style name="Widget.App.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="backgroundTint">@color/surfaceVariantColor</item>
    </style>
    <style name="Widget.App.Snackbar.TextView" parent="Widget.MaterialComponents.Snackbar.TextView">
        <item name="android:textColor">@color/primaryTextColor</item>
        <item name="android:fontFamily">@font/jetbrains_mono</item>
        <item name="android:textSize">12.5sp</item>
    </style>
    <style name="Widget.App.Snackbar.Button" parent="Widget.MaterialComponents.Button.TextButton.Snackbar">
        <!-- The outlined default button style would otherwise leak its stroke in -->
        <item name="strokeWidth">0dp</item>
        <item name="android:textColor">@color/ledOnlineColor</item>
    </style>
</resources>
