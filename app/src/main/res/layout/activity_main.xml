<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:orientation="vertical"
    tools:context=".ui.MainActivity">

    <LinearLayout
        android:id="@+id/console_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/console_row_divider"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/header_title"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textAllCaps="true"
                android:fontFamily="@font/doto_extrabold"
                android:textAppearance="@style/TextAppearance.App.Display.Title"
                app:autoSizeMaxTextSize="30sp"
                app:autoSizeMinTextSize="16sp"
                app:autoSizeTextType="uniform"
                tools:text="AWEKEN" />

            <TextView
                android:id="@+id/header_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.App.Meta"
                android:visibility="gone"
                tools:text="red 192.168.1.0/24 · 3 equipos"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/header_counter_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/header_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/doto_extrabold"
                android:textAppearance="@style/TextAppearance.App.Display"
                android:textColor="@color/ledOnlineColor"
                android:textSize="24sp"
                tools:text="2/3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/header_online_label"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/content_main" />
    </FrameLayout>

    <View
        android:id="@+id/console_tabs_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/consoleLineColor" />

    <LinearLayout
        android:id="@+id/console_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_devices"
            style="@style/Widget.App.ConsoleTab"
            android:text="@string/tab_devices" />

        <TextView
            android:id="@+id/tab_scan"
            style="@style/Widget.App.ConsoleTab"
            android:text="@string/tab_scan" />

        <TextView
            android:id="@+id/tab_history"
            style="@style/Widget.App.ConsoleTab"
            android:text="@string/tab_history" />

        <TextView
            android:id="@+id/tab_more"
            style="@style/Widget.App.ConsoleTab"
            android:text="@string/tab_more" />
    </LinearLayout>
</LinearLayout>
