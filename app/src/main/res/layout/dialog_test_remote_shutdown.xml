<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <include
        layout="@layout/item_shutdown_test_result"
        android:id="@+id/result_destination_reached" />

    <include
        layout="@layout/item_shutdown_test_result"
        android:id="@+id/result_authorization" />

    <include
        layout="@layout/item_shutdown_test_result"
        android:id="@+id/result_session" />

    <include
        layout="@layout/item_shutdown_test_result"
        android:id="@+id/result_command_execute" />

    <TextView
        android:id="@+id/result_optional_error_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="40dp"
        android:lineSpacingMultiplier="1.3"
        android:textAppearance="@style/TextAppearance.App.Meta"
        android:textColor="@color/ledOfflineColor"
        android:textSize="12.5sp" />

</LinearLayout>