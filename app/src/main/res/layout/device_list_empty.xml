<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:minHeight="360dp"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/device_list_empty_figure"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/device_list_empty_figure"
        android:fontFamily="@font/doto_extrabold"
        android:textAppearance="@style/TextAppearance.App.Display"
        android:textColor="@color/primaryTextColorMuted"
        android:textSize="56sp" />

    <TextView
        android:id="@+id/device_list_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/device_list_empty_title"
        android:fontFamily="@font/doto_extrabold"
        android:textAppearance="@style/TextAppearance.App.Display"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/device_list_empty_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/device_list_empty_hint"
        android:textAppearance="@style/TextAppearance.App.Meta"
        android:textSize="12sp" />
</LinearLayout>
