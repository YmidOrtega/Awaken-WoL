<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/onboarding_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/console_row_divider"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/onboarding_step"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/doto_extrabold"
            android:textAppearance="@style/TextAppearance.App.Display"
            android:textColor="@color/ledOnlineColor"
            android:textSize="24sp"
            tools:text="01/03" />

        <TextView
            android:id="@+id/onboarding_skip"
            style="@style/Widget.App.ConsoleAction.Dim"
            android:layout_height="48dp"
            tools:text="› saltar" />
    </LinearLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/onboarding_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.ymid.wakeonlan.ui.SegmentBarView
        android:id="@+id/onboarding_indicator"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/onboarding_next"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="24dp"
        tools:text="› siguiente" />

</LinearLayout>
