<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/cardBackgroundColor"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:cardUseCompatPadding="true"
    app:strokeColor="@color/cardStrokeColor"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:id="@+id/device_status"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/device_status_unknown" />

                <TextView
                    android:id="@+id/device_name"
                    style="@style/FontMonospaced"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:textColor="@color/primaryTextColor"
                    android:textStyle="bold"
                    tools:text="Device Name" />
            </LinearLayout>

            <com.ymid.wakeonlan.ui.ObfuscatedTextView
                android:id="@+id/device_mac"
                style="@style/FontMonospaced"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAllCaps="true"
                android:textAppearance="?attr/textAppearanceBody2"
                android:textColor="@color/primaryTextColorMuted"
                tools:text="••:••:••:••:••:0f" />

            <TextView
                android:id="@+id/device_status_details"
                style="@style/FontMonospaced"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/device_status_unknown"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="@color/primaryTextColorMuted"
                tools:text="Online · Network: 12 ms" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:weightSum="3"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/edit"
                style="@style/Widget.App.Button.ActionPill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="@string/device_list_edit"
                app:icon="@drawable/ic_edit_24"
                app:iconTint="@color/actionEditColor" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/send_wol"
                style="@style/Widget.App.Button.ActionPill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="@string/device_list_startup"
                app:icon="@drawable/ic_power_24"
                app:iconTint="@color/actionWakeColor" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shutdown"
                style="@style/Widget.App.Button.ActionPill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="@string/device_list_shutdown"
                app:icon="@drawable/ic_power_off_24"
                app:iconTint="@color/actionShutdownColor" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
