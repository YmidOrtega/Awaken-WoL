<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/console_row_divider"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/device_status"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/device_status_unknown" />

        <TextView
            android:id="@+id/device_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="@font/doto_extrabold"
            android:textAppearance="@style/TextAppearance.App.Display.DeviceName"
            tools:text="Ubuntu" />

        <TextView
            android:id="@+id/device_status_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/doto_extrabold"
            android:textAppearance="@style/TextAppearance.App.Display.Figure"
            tools:text="18" />

        <TextView
            android:id="@+id/device_latency_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="@string/device_latency_unit"
            android:textAppearance="@style/TextAppearance.App.Meta"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/device_ip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Meta"
            tools:text="192.168.1.40" />

        <com.ymid.wakeonlan.ui.ObfuscatedTextView
            android:id="@+id/device_mac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.App.Meta"
            tools:text="••:••:••:••:••:4F" />
    </LinearLayout>

    <com.ymid.wakeonlan.ui.list.SparklineView
        android:id="@+id/device_latency_sparkline"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/send_wol"
            style="@style/Widget.App.ConsoleAction"
            android:text="@string/device_action_wake" />

        <TextView
            android:id="@+id/shutdown"
            style="@style/Widget.App.ConsoleAction"
            android:text="@string/device_action_shutdown" />

        <TextView
            android:id="@+id/edit"
            style="@style/Widget.App.ConsoleAction.Dim"
            android:text="@string/device_action_edit" />

        <TextView
            android:id="@+id/device_wake_log"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:gravity="center_vertical"
            android:text="@string/device_waking_log"
            android:textAppearance="@style/TextAppearance.App.Meta"
            android:textColor="@color/ledWakingColor"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
