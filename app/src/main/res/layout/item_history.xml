<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/console_row_divider"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/history_icon"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="9dp"
            android:background="@drawable/device_status_online" />

        <TextView
            android:id="@+id/history_device_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/doto_extrabold"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Display"
            android:textSize="17sp"
            tools:text="Ubuntu" />

        <TextView
            android:id="@+id/history_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="@style/TextAppearance.App.Meta"
            tools:text="oct 12 · 11:48" />
    </LinearLayout>

    <TextView
        android:id="@+id/history_action_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="19dp"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.App.Meta"
        android:textSize="12sp"
        tools:text="» wake" />
</LinearLayout>
