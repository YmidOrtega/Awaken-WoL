<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/console_row_divider"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/trusted_wifi_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.App.Meta"
        android:textColor="@color/primaryTextColor"
        android:textSize="14sp"
        tools:text="Ymid" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/trusted_wifi_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/trusted_wifi_delete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_delete"
        android:padding="12dp"
        android:src="@drawable/ic_delete"
        android:visibility="gone"
        app:tint="@color/ledOfflineColor" />
</LinearLayout>
