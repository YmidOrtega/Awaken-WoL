<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <ImageView
        android:id="@+id/onboarding_icon"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginStart="-16dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/onboarding_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/doto_extrabold"
        android:textAppearance="@style/TextAppearance.App.Display"
        android:textSize="30sp"
        tools:text="Bienvenido a Janus" />

    <TextView
        android:id="@+id/onboarding_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingMultiplier="1.35"
        android:textAppearance="@style/TextAppearance.App.Meta"
        android:textSize="14sp"
        tools:text="Enciende y apaga tu PC desde cualquier lugar de tu red" />

</LinearLayout>
