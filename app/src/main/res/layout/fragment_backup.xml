<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/console_row_divider"
            android:lineSpacingMultiplier="1.3"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp"
            android:text="@string/backup_description"
            android:textAppearance="@style/TextAppearance.App.Meta"
            android:textColor="@color/primaryTextColor"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/console_row_divider"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/backup_note"
                android:textAppearance="@style/TextAppearance.App.Label"
                android:textColor="@color/ledWakingColor" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/backup_note_content"
                android:textAppearance="@style/TextAppearance.App.Meta"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/button_export"
            style="@style/Widget.App.ConsoleRowAction"
            android:text="@string/backup_action_export" />

        <TextView
            android:id="@+id/button_import"
            style="@style/Widget.App.ConsoleRowAction"
            android:text="@string/backup_action_import" />
    </LinearLayout>
</ScrollView>
