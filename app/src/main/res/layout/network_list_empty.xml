<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:minHeight="320dp"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/network_scan_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/doto_extrabold"
        android:gravity="center"
        android:text="@string/network_scan_no_devices_found"
        android:textAppearance="@style/TextAppearance.App.Display"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/network_scan_empty_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/network_scan_empty_title"
        android:textAppearance="@style/TextAppearance.App.Meta"
        android:textSize="12sp" />
</LinearLayout>
