<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <SwitchPreferenceCompat
        app:iconSpaceReserved="false"
        android:key="pref_require_auth"
        android:title="@string/pref_require_auth_title"
        android:summary="@string/pref_require_auth_summary"
        android:defaultValue="true" />

    <PreferenceCategory
        app:iconSpaceReserved="false"
        android:title="@string/pref_auth_network_category">
        <Preference
            app:iconSpaceReserved="false"
            android:key="pref_scan_wifi"
            android:title="@string/pref_scan_wifi_title"
            android:summary="@string/pref_scan_wifi_summary" />

        <Preference
            app:iconSpaceReserved="false"
            android:key="pref_trusted_ssids"
            android:title="@string/pref_trusted_ssids_title"
            android:summary="@string/pref_trusted_ssids_summary" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        android:title="@string/pref_monitoring_category">
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            android:key="pref_monitoring_enabled"
            android:title="@string/pref_monitoring_enabled_title"
            android:summary="@string/pref_monitoring_enabled_summary"
            android:defaultValue="true" />
    </PreferenceCategory>
</PreferenceScreen>
