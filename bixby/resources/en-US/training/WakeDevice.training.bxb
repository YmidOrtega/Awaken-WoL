training {
  // Pattern: explicit device name
  "[wake|turn on|start|boot] [my|the] #{value(WakeDevice.deviceName)} [in Janus|using Janus|with Janus]" {
    goal: WakeDevice
    value-set {
      WakeDevice.deviceName = #{value(WakeDevice.deviceName)}
    }
  }

  // Pattern: "wake my PC" without a specific name — Bixby will ask which device
  "[wake|turn on|start|boot] [my|the] [PC|computer|laptop|device|machine] [in Janus|using Janus|with Janus]" {
    goal: WakeDevice
  }

  // Minimal pattern
  "[wake|power on] #{value(WakeDevice.deviceName)}" {
    goal: WakeDevice
    value-set {
      WakeDevice.deviceName = #{value(WakeDevice.deviceName)}
    }
  }
}
